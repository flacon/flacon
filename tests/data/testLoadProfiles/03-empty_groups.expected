[Profiles/AAC]
    OutDirectory=:Music
    OutPattern=%a/{%y - }%A/%n - %t
    Format=AAC
    Name=AAC
    BitsPerSample=0
    SampleRate=0
    CreateCue=false
    CueFileName = %a-%A.cue
    PregapType = Extract
    CoverFile/Mode=Disable
    CoverFile/Size=1024
    CoverEmbed/Mode=Disable
    CoverEmbed/Size=1024
    EmbedCue=false
    ReplayGain=Disable
    Tags\WriteSingleDiskNum=true
    Encoder/Bitrate=256
    Encoder/Quality=100
    Encoder/UseQuality=true
    Encoder/Fdkaac/UseVBR = true
    Encoder/Fdkaac/Quality = 5
    Encoder/Fdkaac/Bitrate = 320



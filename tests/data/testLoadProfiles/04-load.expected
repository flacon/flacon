[Profiles/AAC]
    OutDirectory=~/Music/aac
    OutPattern=aac-%a/{%y - }%A/%n - %t
    Format=AAC
    Name=Aac
    BitsPerSample=16
    SampleRate=44100
    CreateCue=false
    CueFileName = AAC %a %d - %A.cue
    PregapType = AddToFirst
    CoverFile/Mode=Scale
    CoverFile/Size=600
    CoverEmbed/Mode=Disable
    CoverEmbed/Size=1024
    EmbedCue=false
    ReplayGain=Disable
    Tags\WriteSingleDiskNum=false
    Encoder/Bitrate=128
    Encoder/Quality=90
    Encoder/UseQuality=false


[Profiles/FLAC]
    OutDirectory=~/Music/flac
    OutPattern=flac-%a/{%y - }%A/%n - %t
    Format=FLAC
    Name=Flac
    ReplayGain=Track
    BitsPerSample=16
    SampleRate=44100
    CreateCue=true
    CueFileName = FLAC %a %d - %A.cue
    PregapType = Extract
    CoverFile/Mode=OrigSize
    CoverFile/Size=600
    CoverEmbed/Mode=Scale
    CoverEmbed/Size=800
    EmbedCue=false
    Tags\WriteSingleDiskNum=true
    Encoder/Compression=3


[Profiles/MP3]
    OutDirectory=~/Music/mp3
    OutPattern=mp3-%a/{%y - }%A/%n - %t
    Format = MP3
    Name = Mp3
    ReplayGain=Album
    BitsPerSample=16
    SampleRate=44100
    CreateCue=false
    CueFileName = MP3 %a %d - %A.cue
    PregapType = Skip
    CoverFile/Mode=Scale
    CoverFile/Size=600
    CoverEmbed/Mode=Disable
    CoverEmbed/Size=1024
    EmbedCue=false
    Tags\WriteSingleDiskNum=false
    Encoder/Preset=vbrStandard
    Encoder/Bitrate=320
    Encoder/Quality=4


